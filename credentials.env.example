# VPN自动化系统凭证文件
# 重要: 复制此文件为credentials.env并填入实际的API密钥和令牌
# 注意: credentials.env已在.gitignore中排除，不会提交到Git仓库

# 云服务商API密钥
VULTR_API_KEY=your_vultr_api_key
DO_TOKEN=your_digitalocean_token
LINODE_TOKEN=your_linode_token
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Netmaker配置
NETMAKER_SERVER=netmaker.your-domain.com
NETMAKER_API_TOKEN=your_netmaker_api_token
NETMAKER_JOIN_TOKEN=your_netmaker_join_token

# Marzban配置
MARZBAN_SERVER=panel.your-domain.com
MARZBAN_API_TOKEN=your_marzban_api_token
MARZBAN_ADMIN_USERNAME=admin
MARZBAN_ADMIN_PASSWORD=secure_password

# 证书配置
ACME_EMAIL=your-email@example.com

# DNS API认证 (用于DNS-01验证)
# Cloudflare
CF_Key=your_cloudflare_key
CF_Email=your_cloudflare_email

# 阿里云
Ali_Key=your_aliyun_key
Ali_Secret=your_aliyun_secret

# DNSPod
DP_Id=your_dnspod_id
DP_Key=your_dnspod_key

# 监控和告警
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
